<script>
  function toggleMenu() {
    const dialog = document.getElementById('sidebarDialog');
    const menuBtn = document.getElementById('menuToggle');
    if (dialog.open) {
      dialog.close();
      menuBtn.setAttribute('aria-expanded', 'false');
    } else {
      dialog.showModal();
      menuBtn.setAttribute('aria-expanded', 'true');
    }
  }
  document.getElementById('sidebarDialog')?.addEventListener('close', () => {
    document.getElementById('menuToggle')?.setAttribute('aria-expanded', 'false');
  });
</script>
<script>
  function openStoreModal(button) {
    const dialog = document.getElementById('storeModal');
    if (button && dialog) {
      const storeName = button.getAttribute('data-store-name');
      const storeUrl = button.getAttribute('data-store-url');
      const embedCode = button.getAttribute('data-embed-code');
      const titleEl = document.getElementById('title');
      if (titleEl) {
        titleEl.textContent = storeName ? `Listen on ${storeName}` : 'Options';
      }
      const directLink = document.getElementById('storeDirectLink');
      if (directLink && storeUrl) {
        directLink.href = storeUrl;
        directLink.textContent = `Open in ${storeName || 'App'}`;
      }
      const embedWrapper = document.getElementById('embedWrapper');
      if (embedWrapper && embedCode) {
        embedWrapper.innerHTML = embedCode;
      }
    }
    if (dialog && !dialog.open) {
      dialog.showModal();
    }
  }
</script>
<script id="copyReleaseLinkScript">
    document.getElementById('copyReleaseBtn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const linkToCopy = btn.getAttribute('data-link');
    const toast = document.getElementById('copyToast');
    try {
      await navigator.clipboard.writeText(linkToCopy);
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2000);
    } catch (err) {
      console.error('Failed to copy link:', err);
    }
  });
  </script>