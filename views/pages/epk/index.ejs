<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700&display=swap">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="https://beesyrupmusic.com/epk">
    <title>BeeSyrup Musician Official EPK | Bio, Music & Booking Info</title>
    <meta name="description" content="Explore the official Electronic Press Kit for BeeSyrup. Access official bios, press photos, latest music releases, and direct booking contacts.">
    <link rel="apple-touch-icon" href="https://beesyrupmusic.com/apple-touch-icon.png" sizes="180x180">
    <link rel="icon" type="image/svg+xml" href="https://beesyrupmusic.com/favicon.svg">
    <link rel="icon" type="image/png" href="https://beesyrupmusic.com/favicon.png" sizes="512x512">
    <link rel="icon" type="image/x-icon" href="https://beesyrupmusic.com/favicon.ico">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="stylesheet" href="/style.css">
    <meta name="theme-color" content="#FAFF00">
    <meta name="robots" content="index, follow">
    <meta name="author" content="BeeSyrup">

    <meta property="og:site_name" content="BeeSyrup">
    <meta property="og:type" content="website">
    <meta property="og:title" content="BeeSyrup Musician Official EPK | Bio, Music & Booking Info">
    <meta property="og:description" content="Explore the official Electronic Press Kit for BeeSyrup. Access official bios, press photos, latest music releases, and direct booking contacts.">
    <meta property="og:url" content="https://beesyrupmusic.com/epk">
    <meta property="og:image" content="https://beesyrupmusic.com/images/preview.jpg">
    <meta property="og:image:alt" content="BeeSyrup Logo">

    <meta name="twitter:title" content="BeeSyrup Musician Official EPK | Bio, Music & Booking Info">
    <meta name="twitter:description" content="Explore the official Electronic Press Kit for BeeSyrup. Access official bios, press photos, latest music releases, and direct booking contacts.">
    <meta name="twitter:url" content="https://beesyrupmusic.com/epk">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://beesyrupmusic.com/images/preview.jpg">
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js')
          .then((registration) => { console.log('Service Worker active:', registration.scope); })
          .catch((error) => { console.error('Service Worker registration failed:', error); });
      });
    }
  </script>
</head>
<body>
  <header class="website-header">
    <%- include(header, { tracks: release.tracks, release: release }) %>
  </header>

  <div class="Container">
    
    <header>
      <div>
        <h1>BeeSyrup</h1>
        <div class="PillBadgeRow">
          <span class="PillBadge">Electronic / Ambient</span>
          <span class="PillBadge">Holmfirth, UK</span>
          <span class="PillBadge">Independent Artist</span>
        </div>
      </div>
    </header>

    <div class="CardPrimary">
      
      <div>
        <h3>Biography</h3>
        <p>BeeSyrup is an independent electronic music project rooted in Holmfirth, UK. Blending atmospheric textures, intricate rhythms, and evocative soundscapes, the project explores the space between nostalgic analog warmth and modern electronic production.</p>
        
        <h3 style="margin-top: 32px;">Media Gallery</h3>
        <div class="PhotoGrid">
          <div class="Photo"><span><img src="/images/beesyrup.jpg" alt="BeeSyrup Press Photo" style="width:100%; height:100%; object-fit:cover; border-radius:inherit;"></span></div>
          <div class="Photo"><span><img src="https://beesyrupmusic.com/assets/releases/fallen-friends/coverart/fallen-friends-cover-2000x2000.jpg" alt="BeeSyrup Release Artwork" style="width:100%; height:100%; object-fit:cover; border-radius:inherit;"></span></div>
        </div>
      </div>

      <div>
        <h3>Featured Tracks</h3>
        <ul class="Tracks">
          <li>
            <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
              <span class="TrackNumber">01</span>
              <div class="TrackTitle"><a href="https://soundcloud.com/beesyrupmusic" target="_blank">Latest Release Track 1</a></div>
            </div>
            <span class="TrackTime">3:30</span>
          </li>
          <li>
            <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
              <span class="TrackNumber">02</span>
              <div class="TrackTitle"><a href="https://soundcloud.com/beesyrupmusic" target="_blank">Latest Release Track 2</a></div>
            </div>
            <span class="TrackTime">4:05</span>
          </li>
          <li>
            <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
              <span class="TrackNumber">03</span>
              <div class="TrackTitle"><a href="https://soundcloud.com/beesyrupmusic" target="_blank">Latest Release Track 3</a></div>
            </div>
            <span class="TrackTime">3:15</span>
          </li>
        </ul>

        <h3 style="margin-top: 32px;">Contact & Booking</h3>
        <p style="font-size: 0.95rem; line-height: 1.5; color: var(--text-muted);">
          For press inquiries, sync licensing, or booking information, please reach out via official channels or social platforms below.
        </p>
      </div>
      <% if (release && release.tracks && release.tracks.length > 0) { %>
        <%- include(tracklist, { tracks: release.tracks, release: release }) %>
      <% } else { %>
      <div class="CardPrimary" style="width: 100%; padding: 20px;">
        <p style="color: #666; margin: 0; text-align: center;">No tracks available for this release.</p>
      </div>
      <% } %>
    </div>

    <div class="LinkList" style="margin-top: 24px; padding: 20px; background: var(--bg-alt); border: 1px solid var(--border);">
      <span class="Pill"><a href="https://spotify.com" target="_blank" style="color: var(--spotify);">Spotify</a></span>
      <span class="Pill"><a href="https://apple.com/music" target="_blank" style="color: var(--applemusic);">Apple Music</a></span>
      <span class="Pill"><a href="https://soundcloud.com/beesyrupmusic" target="_blank" style="color: var(--soundcloud);">Soundcloud</a></span>
      <span class="Pill"><a href="https://bandcamp.com" target="_blank" style="color: var(--bandcamp);">Bandcamp</a></span>
    </div>

    <footer>
      <p>&copy; 2026 BeeSyrup. All Rights Reserved.</p>
    </footer>

  </div>

</body>
</html>