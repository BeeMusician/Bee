<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: #0b0f19;
            color: #f3f4f6;
            margin: 0;
            padding: 2rem;
        }
        .release-section, .release-card {
            background-color: #111827;
            border: 1px solid #1f2937;
            border-radius: 0.5rem;
            padding: 1.5rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        @media (min-width: 768px) {
            .release-section, .release-card {
                padding: 2rem;
            }
        }
        .flex-container {
            display: flex;
            flex-direction: column;
            gap: 2rem;
            align-items: center;
        }
        @media (min-width: 768px) {
            .flex-container {
                flex-direction: row;
            }
        }
        .cover-art {
            width: 16rem;
            height: 16rem;
            object-fit: cover;
            border-radius: 0.375rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .grid-container {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
        @media (min-width: 768px) {
            .grid-container { grid-template-columns: repeat(2, 1fr); }
        }
        @media (min-width: 1024px) {
            .grid-container { grid-template-columns: repeat(3, 1fr); }
        }
        .btn-primary {
            background-color: #4f46e5;
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            text-decoration: none;
            transition: background-color 0.2s;
            display: inline-block;
        }
        .btn-primary:hover {
            background-color: #4338ca;
        }
        .text-muted { color: #9ca3af; }
        .tracklist { list-style: none; padding: 0; margin: 0; }
        .track-item {
            padding: 0.75rem 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #1f2937;
        }
    </style>
</head>
<body>
    <% if (typeof release !== 'undefined' && release) { %>
        <!-- ================= SINGLE RELEASE VIEW ================= -->
        <section class="release-section">
            <div class="flex-container">
                <% if (release.coverArt) { %>
                    <img src="<%= release.coverArt %>" alt="<%= release.title %> Cover Art" class="cover-art">
                <% } %>
                <div>
                    <h1 style="font-size: 1.875rem; font-weight: bold; margin-bottom: 0.5rem;"><%= release.title %></h1>
                    <p class="text-muted" style="margin-bottom: 1rem;"><%= release.description || 'Independent electronic release by BeeSyrup.' %></p>
                    
                    <% if (release.releaseDate) { %>
                        <p class="text-muted" style="font-size: 0.875rem; margin-bottom: 1rem;">Released: <%= release.releaseDate %></p>
                    <% } %>

                    <div>
                        <% if (release.id_spotify) { %>
                            <a href="https://open.spotify.com/album/<%= release.id_spotify %>" target="_blank" rel="noopener" class="btn-primary">Listen / Buy</a>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Tracklist Section -->
            <% if (release.tracks && release.tracks.length > 0) { %>
                <div style="margin-top: 2rem; border-top: 1px solid #1f2937; padding-top: 1.5rem;">
                    <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">Tracklist</h2>
                    <ul class="tracklist">
                        <% release.tracks.forEach((track, index) => { %>
                            <li class="track-item text-muted">
                                <span><%= index + 1 %>. <%= track.title %></span>
                                <% if (track.duration) { %>
                                    <span style="font-size: 0.875rem;"><%= track.duration %></span>
                                <% } %>
                            </li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>
        </section>

    <% } else if (typeof releases !== 'undefined' && releases.length > 0) { %>
        <!-- ================= RELEASES LIST VIEW ================= -->
        <header style="margin-bottom: 2rem;">
            <h1 style="font-size: 2.25rem; font-weight: bold; margin-bottom: 0.5rem;">All Releases</h1>
            <p class="text-muted">Explore the complete catalog of music and sound design projects.</p>
        </header>

        <div class="grid-container">
            <% releases.forEach((item) => { %>
                <article class="release-card" style="display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                        <% if (item.coverArt) { %>
                            <img src="<%= item.coverArt %>" alt="<%= item.title %> Cover" width="200" height="200" style="border-radius: 0.375rem; object-fit: cover;">
                        <% } %>
                        <h2 style="font-size: 1.25rem; font-weight: bold; margin: 0.75rem 0 0.25rem 0;">
                            <a href="/<%= artistSlug %>/release/<%= item.slug %>" class="text-muted" style="text-decoration: none; color: inherit;"><%= item.title %></a>
                        </h2>
                        <p class="text-muted" style="font-size: 0.875rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"><%= item.description || '' %></p>
                    </div>
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #1f2937; display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 0.75rem;" class="text-muted"><%= item.releaseDate || '' %></span>
                        <a href="/<%= artistSlug %>/release/<%= item.slug %>" style="color: #818cf8; text-decoration: none; font-size: 0.875rem; font-weight: 500;">View Release &rarr;</a>
                    </div>
                </article>
            <% }) %>
        </div>

    <% } else { %>
        <!-- ================= FALLBACK / EMPTY STATE ================= -->
        <div style="text-align: center; padding: 5rem 0;">
            <h1 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 0.5rem;">No Releases Found</h1>
            <p class="text-muted" style="margin-bottom: 1.5rem;">Check back soon for new music drops.</p>
            <a href="/" style="color: #818cf8; text-decoration: none;">&larr; Return Home</a>
        </div>
    <% } %>
</body>
</html>