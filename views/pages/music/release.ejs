<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700&display=swap">
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/style.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= release.title %> by <%= release.artist %> (<%= release.type %>)</title>
</head>
<body>
  <header>
    <%- include(header, { tracks: release.tracks, release: release }) %>
  </header>
  <main>
    <article>
      <picture>
        <source media="(max-width: 900px)" srcset="<%= release.cover_art %>">
        <img id="coverart" src="<%= release.cover_art %>" width="100" height="100" alt="<%= release.name %> Cover Art">
      </picture>
      <% if (typeof release.tracks !== 'undefined' && release.tracks.length > 0) { %>
        <%- include(tracklist, { tracks: release.tracks, release: release }) %>
      <% } else { %>
        <p>No tracks available for this release.</p>
      <% } %>
    </article>
  </main>
  <%- include(sidebar, { tracks: release.tracks, release: release }) %>
  <%- include(storemodule, { tracks: release.tracks, release: release }) %>
  <script src="/js/beeBG.js"></script>
</body>
</html>