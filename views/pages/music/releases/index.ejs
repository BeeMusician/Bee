<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof release !== 'undefined' && release ? release.title + ' | BeeSyrup' : 'Releases | BeeSyrup' %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-dark text-white font-sans min-h-screen p-6">

    <main class="max-w-4xl mx-auto">
        <!-- Navigation / Back Link -->
        <nav class="mb-6">
            <a href="/" class="text-gray-400 hover:text-white transition">&larr; Back to Home</a>
        </nav>

        <% if (typeof release !== 'undefined' && release) { %>
            <!-- ================= SINGLE RELEASE VIEW ================= -->
            <section class="bg-gray-900 border border-gray-800 rounded-lg p-6 md:p-8 shadow-lg">
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <% if (release.coverArt) { %>
                        <img src="<%= release.coverArt %>" alt="<%= release.title %> Cover Art" class="w-64 h-64 object-cover rounded-md shadow-md">
                    <% } %>
                    <div>
                        <h1 class="text-3xl font-bold mb-2"><%= release.title %></h1>
                        <p class="text-gray-400 mb-4"><%= release.description || 'Independent electronic release by BeeSyrup.' %></p>
                        
                        <% if (release.releaseDate) { %>
                            <p class="text-sm text-gray-500 mb-4">Released: <%= release.releaseDate %></p>
                        <% } %>

                        <!-- Action links (Bandcamp, Spotify, etc.) -->
                        <div class="flex gap-4">
                            <% if (release.id_spotify) { %>
                                <a href="https://open.spotify.com/album/<%= release.id_spotify %>" target="_blank" rel="noopener" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded transition">Listen / Buy</a>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Tracklist Section -->
                <% if (release.tracks && release.tracks.length > 0) { %>
                    <div class="mt-8 border-t border-gray-800 pt-6">
                        <h2 class="text-xl font-semibold mb-4">Tracklist</h2>
                        <ul class="divide-y divide-gray-800">
                            <% release.tracks.forEach((track, index) => { %>
                                <li class="py-3 flex justify-between items-center text-gray-300">
                                    <span><%= index + 1 %>. <%= track.title %></span>
                                    <% if (track.duration) { %>
                                        <span class="text-sm text-gray-500"><%= track.duration %></span>
                                    <% } %>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>
            </section>

        <% } else if (typeof releases !== 'undefined' && releases.length > 0) { %>
            <!-- ================= RELEASES LIST VIEW ================= -->
            <header class="mb-8">
                <h1 class="text-4xl font-bold mb-2">All Releases</h1>
                <p class="text-gray-400">Explore the complete catalog of music and sound design projects.</p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% releases.forEach((item) => { %>
                    <article class="bg-gray-900 border border-gray-800 rounded-lg p-4 flex flex-col justify-between hover:border-gray-700 transition">
                        <div>
                            <% if (item.coverArt) { %>
                                <img src="<%= item.coverArt %>" alt="<%= item.title %> Cover" width="200" height="200">
                            <% } %>
                            <h2 class="text-xl font-bold mb-1">
                                <a href="/release/<%= item.slug %>" class="hover:underline"><%= item.title %></a>
                            </h2>
                            <p class="text-gray-400 text-sm line-clamp-2"><%= item.description || '' %></p>
                        </div>
                        <div class="mt-4 pt-4 border-t border-gray-800 flex justify-between items-center">
                            <span class="text-xs text-gray-500"><%= item.releaseDate || '' %></span>
                            <a href="/release/<%= item.slug %>" class="text-indigo-400 hover:underline text-sm font-medium">View Release &rarr;</a>
                        </div>
                    </article>
                <% }) %>
            </div>

        <% } else { %>
            <!-- ================= FALLBACK / EMPTY STATE ================= -->
            <div class="text-center py-20">
                <h1 class="text-2xl font-bold mb-2">No Releases Found</h1>
                <p class="text-gray-400 mb-6">Check back soon for new music drops.</p>
                <a href="/" class="text-indigo-400 hover:underline">&larr; Return Home</a>
            </div>
        <% } %>
    </main>

</body>
</html>