<dialog id="storeModal" style="background: var(--branding-accent-primary-HEX); border: 0px solid var(--branding-accent-primary-HEX)">
  <div class="CardPrimary">
    <div class="CardContent">
      <!-- Added id="modalTitle" -->
      <h2 id="modalTitle" class="TracklistHeading"><%= release.name %> Options</h2>
      
      <!-- Optional: Direct Link that your JS points to -->
      <p>
        <a id="storeDirectLink" href="#" target="_blank" rel="noopener noreferrer" style="color: var(--branding-accent-secondary-HEX)">Go to Link</a>
      </p>

      <!-- Optional: Embed Section that your JS toggles/populates -->
      <div id="embedSection" style="display: none;">
        <p id="embedText"></p>
        <div id="embedWrapper"></div>
      </div>

      <div class="Container">
        <ul class="Tracks">
          <% tracks.forEach(function(track, index) { %>
            <li class="TrackRow" data-track-number="<%= index + 1 %>" data-duration="<%= track.duration ? track.duration.replace('PT', '').replace('M', ':').replace('S', '') : '0:00' %>">
              <span class="PillBadge" style="color: var(--branding-accent-primary-HEX)"><%= index + 1 %></span>
              <a href="/track/<%= track.slug %>"><%= track.name.trim() %></a>
              <span class="PillBadge" style="color: var(--branding-accent-primary-HEX)"><%= track.isrc %></span>
              <button type="button" class="copy-track-btn" data-slug="<%= track.slug %>" onclick="copyTrackUrl(this)" title="Copy Link" aria-label="Copy Link">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                </svg>
              </button>
            </li>
          <% }); %>

          <li class="TrackRow TotalRow">
            <span class="TrackTitle TotalLabel">Total Duration</span>
            <span class="TrackTime">
              <time datetime="<%= release.duration || 'N/A' %>"><%= release.release_duration || 'N/A' %></time>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <!-- Make sure you have a close button for your dialog -->
  <button type="button" onclick="document.getElementById('storeModal').close()">Close</button>
</dialog>