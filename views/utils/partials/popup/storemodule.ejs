<dialog id="storeModal" style="background: var(--branding-accent-primary-HEX); border: 0px solid var(--branding-accent-primary-HEX)">
  <div class="CardPrimary">
    <div class="CardContent">
      <h2 id="title" class="TracklistHeading"> Options</h2>
      
      <p>
        <a id="storeDirectLink" href="#" target="_blank" rel="noopener noreferrer" style="color: var(--branding-accent-secondary-HEX)"></a>
