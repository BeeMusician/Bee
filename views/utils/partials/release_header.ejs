  <div class="header-center">
    <div class="release-wrapper">
      <div class="cover-art">
        <img src="<%= release.cover_art %>" alt="Release Cover" />
      </div>
      <div class="release-badge-text">
        <time class="release-date" datetime="<%= release.release_date %>"><%= release.date %></time>
        <div class="subtitle-row">
          <span class="pulse-dot"></span>
          <span>Newest Release (<%= release.type.toUpperCase() %>)</span>
          <span class="release-tag">New</span>
        </div>
        <span class="release-title-text"><%= release.name %></span>
      </div>
    </div>
    <div class="search-container">
      <input type="search" placeholder="Search catalog..." aria-label="Search catalog" class="header-search-input" />
    </div>
  </div>
  <div class="header-right">
    <nav class="header-nav" aria-label="Main Navigation">
      <a href="/catalog" class="nav-link">Catalog</a>
      <a href="/about" class="nav-link">About</a>
      <a href="/contact" class="nav-link">Contact</a>
    </nav>
  </div>
</div>

<script>
  function toggleMenu() {
    const dialog = document.getElementById('sidebarDialog');
    const menuBtn = document.getElementById('menuToggle');
    if (dialog.open) {
      dialog.close();
      menuBtn.setAttribute('aria-expanded', 'false');
    } else {
      dialog.showModal();
      menuBtn.setAttribute('aria-expanded', 'true');
    }
  }
  document.getElementById('sidebarDialog')?.addEventListener('close', () => {
    document.getElementById('menuToggle')?.setAttribute('aria-expanded', 'false');
  });
</script>