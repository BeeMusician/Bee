<div class="CardPrimary">
  <div class="CardContent">
    <h2 class="TracklistHeading"><%= release.name %> Tracklist</h2>
    <div class="Container">
      <ul class="Tracks">
        <% tracks.forEach(function(track, index) { %>
          <li class="TrackRow" data-track-number="<%= index + 1 %>" data-duration="<%= track.duration ? track.duration.replace('PT', '').replace('M', ':').replace('S', '') : '0:00' %>">
            <span class="PillBadge" style="color: var(--branding-accent-primary-HEX)"><%= index + 1 %></span>
            <a href="/track/<%= track.slug %>"><%= track.name.trim() %></a>
            <span class="PillBadge" style="color: var(--branding-accent-primary-HEX)"><%= track.isrc %></span>
            <div class="IconList">
              <% if (track.apple_music_id) { %>
                <div href="https://music.apple.com/song/<%= track.apple_music_id %>" target="_blank" rel="noopener noreferrer external" class="IconBtn circle-logo box-logo" title="Listen on Apple Music" aria-label="Listen on Apple Music" style="--grad-start: #FA586A; --grad-end: #FA243C;">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%" class="Icon" aria-hidden="true">
                    <defs>
                      <mask id="apple_Music_Note_Mask-<%= index %>">
                        <circle fill="#FFFFFF" cx="256" cy="256" r="256" />
                        <g fill="#000000" class="scaled-path" style="transform: translate(-16px, -2px) scale(0.85);" transform-origin="50% 50%">
                          <path d="M409.12 59.2c-2.24-.96-4.8-1.12-7.2-.4L196.8 116.8c-5.44 1.6-9.2 6.56-9.2 12.24v237.44c-9.6-4.48-20.8-7.2-32.8-7.2-43.2 0-78.4 27.04-78.4 60.48s35.2 60.48 78.4 60.4878.4-27.04 78.4-60.48V214.64l156.8-47.04v163.12c-9.6-4.48-20.8-7.2-32.8-7.2-43.2 0-78.4 27.04-78.4 60.48s35.2 60.48 78.4 60.4878.4-27.04 78.4-60.48V65.6c0-2.96-1.12-5.92-3.04-8.08-2-2.16-4.8-3.28-7.76-2.72z" />
                        </g>
                      </mask>
                    </defs>
                    <circle fill="#FFFFFF" mask="url(#apple_Music_Note_Mask-<%= index %>)" cx="256" cy="256" r="256" />
                  </svg>
                </div>
              <% } %>
              <% if (track.bandcamp_id) { %>
                <div class="IconBtn circle-logo box-logo store-trigger" data-store-name="Bandcamp" data-store-url="https://beesyrup.bandcamp.com/track/<%= track.slug %>" data-embed-code='<iframe style="border: 0; width: 100%; height: 120px;" src="https://bandcamp.com/EmbeddedPlayer/track=<%= track.bandcamp_id %>/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/artwork=small/transparent=true/" seamless></iframe>' style="--grad-start: #1DA0C3; --grad-end: #1281A0;" title="Listen on Bandcamp" aria-label="Listen on Bandcamp">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%" class="Icon" aria-hidden="true">
                    <defs>
                      <mask id="bandcamp_Mask-<%= index %>">
                        <circle fill="#FFFFFF" cx="256" cy="256" r="256" />
                        <g fill="#000000" class="scaled-path">
                          <path d="M23 396l138-280h330L353 396H23z" />
                        </g>
                      </mask>
                    </defs>
                    <circle fill="#FFFFFF" mask="url(#bandcamp_Mask-<%= index %>)" cx="256" cy="256" r="256" />
                  </svg>
                </div>
              <% } %>
              <% if (track.deezer_id) { %>
                <div class="IconBtn circle-logo box-logo store-trigger" onclick="openStoreModal()" data-store-name="Deezer" data-store-url="https://deezer.com/track/<%= track.slug %>" data-embed-code='<iframe style="border: 0; width: 100%; height: 120px;" src="https://bandcamp.com/EmbeddedPlayer/track=<%= track.bandcamp_id %>/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/artwork=small/transparent=true/" seamless></iframe>' style="--grad-start: #A238FF; --grad-end: #A238FF" title="Listen on Deezer" aria-label="Listen on Deezer">
                  <svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512" class="Icon" aria-hidden="true">
                    <defs>
                      <mask id="deezer-Waveform_Heart_Mask-<%= index %>">
                        <circle fill="#FFFFFF" cx="256" cy="256" r="256" />
                        <g fill="#000000" class="scaled-path">
                          <path d="M110.4 2.6C100.6 8.9 92.8 27.7 85.6 62c-3.1 14.6-3.3 15.2-4 11-2.7-17.5-9.4-34.7-14.9-38-4-2.5-3.9-2.5-7.7.6C38.2 53.1 29.9 184 44.6 260.5c3 15.6 7.5 29.5 11.3 35 3 4.5 7.2 6.5 9.9 4.9 3.6-2.3 8-9.5 10.2-16.8 1.3-4.1 2.5-7.4 2.7-7.3.1.2 1 5.5 1.8 11.8 3.9 28.2 11 57.3 17.5 71.5 15.6 34.5 34.3 22.6 47.5-30.3 1.4-5.6 2.5-11.2 2.5-12.4s.2-2 .5-1.8c.2.3 1.1 8.1 2 17.4 6.7 70.8 18.9 112.5 33.1 112.5 7.9 0 16.7-18.1 23-47.5l1.8-8 2.7 19c6.7 46.7 17.5 80.6 30.1 95 23.8 27 48.1-12.5 60-97.4 1.2-8.8 2.3-15.9 2.4-15.8.2.1 1.2 4.5 2.3 9.7 2.9 13.2 8.6 29.7 12.4 36.1 2 3.3 4.6 6.1 6.8 7.3 3.2 1.7 4 1.8 6.9.6 13-5.4 24.2-49.6 30.5-121.5l.8-8 2.3 10.5c7.5 33.4 18.5 54 29 54 9.7 0 17.7-11.3 25.3-35.4 4.2-13.5 8.6-34 11.1-52 1.1-8.3 2.2-15.1 2.3-15.3.2-.1 1.4 3.1 2.6 7.2 3.9 12.5 10.1 19.2 15.6 16.7 15.3-7 26.6-88.5 22.6-164.1C470.6 69.4 459.7 29 446.5 34c-5.4 2-12.5 18.5-15.6 35.9l-1.3 7.5-3.2-15.5c-6.8-33.6-15.6-54.3-25.3-59.7-4.5-2.6-7.1-2.7-11-.8-7.1 3.7-12.3 12.6-18.6 32.1C365 53.3 358.1 87.1 358 100c-.1 6.3-1.4 3.3-2.9-6.5-5.2-33.7-14.6-58-23.9-61.6-5.6-2.2-12.3 4.6-17.7 17.8-7.3 18.1-15.8 67.8-18.1 106.6-.4 5.9-1 10.4-1.4 10s-1.9-5.5-3.4-11.3c-7.4-28.2-19.5-49-30.2-51.9-10.9-2.9-19.6 4.5-29.3 25-4.7 9.8-12.1 32.5-12.1 37.1 0 1.2-.3 1.8-.7 1.4s-1.3-7.9-2-16.7c-4.3-55.3-13.9-99-24.8-113.4-6.3-8.2-14.3-5.7-20.5 6.5-5.4 10.8-11.6 32.9-14.1 50.7-.7 5.1-1.6 9.3-1.9 9.3-.4 0-1-3.1-1.4-7-1-10.7-5.4-35.2-8.6-48.2-6.7-26.2-14.5-41.9-23.1-46.4-4-2-7-1.7-11.5 1.2M11.3 96.2c-3.2 3.6-5.1 8-7.3 16.9C-1.9 138-.8 184 6.2 202.8c2.3 6.1 6.2 11.2 8.7 11.2 6.3 0 12.1-18.4 14.2-45.2 2.4-30.5-3.4-67.7-11.5-73.4-2.8-1.9-3.9-1.8-6.3.8m483.4-1.1c-4 2.3-8.6 15.7-10.6 31.4-4.5 33.6.2 75.3 9.6 85.7 5.6 6.2 12.2-4.1 15.9-24.7 2.5-13.7 2.6-51.4.2-66.1-2-11.6-4.9-20.2-8.5-24.4-2.7-3.2-3.8-3.5-6.6-1.9" />
                        </g>
                      </mask>
                    </defs>
                    <circle fill="#FFFFFF" mask="url(#deezer-Waveform_Heart_Mask-<%= index %>)" cx="256" cy="256" r="256" />
                  </svg>
                </div>
              <% } %>
              <% if (track.soundcloud_id) { %>
  <div class="IconBtn circle-logo box-logo store-trigger" 
       data-store-name="SoundCloud" 
       data-store-url="https://api.soundcloud.com/tracks/<%= track.soundcloud_id %>" 
       data-embed-code='<iframe width="100%" height="166" scrolling="no" frameborder="no" allow="autoplay" src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/<%= track.soundcloud_id %>&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true"></iframe>'
       title="Listen on SoundCloud" 
       aria-label="Listen on SoundCloud" 
       style="--grad-start: #FF5500; --grad-end: #FF3300; cursor: pointer;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%" class="Icon" aria-hidden="true">
      <defs>
        <mask id="soundcloud_Mask-<%= index %>">
          <!-- Base white circle -->
          <circle fill="#FFFFFF" cx="256" cy="256" r="256" />
          
          <!-- Increased scale and adjusted translation -->
          <g fill="#000000" class="scaled-path" style="transform: scale(1.05) translate(8px, 60px);" transform-origin="50% 50%">
            <path d="M384.5 178c-3.1 0-6.1.3-9 .9-6.9-40.3-41.9-70.9-84-70.9-15.3 0-29.5 4.2-41.6 11.5-5.2-34.1-34.5-60.5-69.9-60.5-38.9 0-70.5 31.6-70.5 70.5 0 2.2.2 4.4.5 6.5C79.8 143 51.2 173.9 51.2 211c0 41.1 33.4 74.5 74.5 74.5h258.8c30.9 0 56-25.1 56-56s-25.1-51.5-56-51.5z" />
          </g>
        </mask>
      </defs>
      
      <!-- Masked final circle -->
      <circle fill="#FFFFFF" mask="url(#soundcloud_Mask-<%= index %>)" cx="256" cy="256" r="256" />
    </svg>
  </div>
<% } %>
              <% if (track.spotify_id) { %>
                <div href="https://open.spotify.com/track/<%= track.spotify_id %>" target="_blank" rel="noopener noreferrer external" class="IconBtn circle-logo box-logo" title="Listen on Spotify" aria-label="Listen on Spotify" style="--grad-start: #1ED760; --grad-end: #1ED760;">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" class="Icon" aria-hidden="true">
                    <defs>
                      <mask id="spotify_Waves-<%= index %>">
                        <circle fill="#FFFFFF" cx="500" cy="500" r="500" />
                        <g fill="#000000" stroke="#000000" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M730.005 762.5c-10 15-30 19.999-45 10-117.498-72.5-265-87.5-440-47.5-17.5 5-35-6.25-40-23.75-5-17.5 6.25-35 23.75-40 190-42.5 352.5-25 485 57.5 15 10 19.999 30 10.25 43.75zm60-160c-12.5 17.5-35 25-52.5 12.5-135-82.5-342.5-107.5-502.5-58.75-20 6.25-41.25-5-47.5-25-6.25-20 5-41.25 25-47.5 182.5-55 415-27.5 570 67.5 17.5 12.5 25 35 12.5 51.25zm5-167.5C631.25 341.25 366.25 333.75 212.5 378.75c-25 7.5-51.25-6.25-58.75-31.25-7.5-25 6.25-51.25 31.25-58.75 175-52.5 478.75-43.75 651.25 58.75 22.5 13.75 30 43.75 16.25 66.25-13.75 22.5-43.75 30-66.25 16.25z" />
                        </g>
                      </mask>
                    </defs>
                    <circle fill="#FFFFFF" mask="url(#spotify_Waves-<%= index %>)" cx="500" cy="500" r="500" />
                  </svg>
                </div>
              <% } %>
              <% if (track.tidal_id) { %>
                <div href="https://tidal.com/browse/track/<%= track.tidal_id %>" target="_blank" rel="noopener noreferrer external" class="IconBtn circle-logo box-logo" title="Listen on TIDAL" aria-label="Listen on TIDAL" style="--grad-start: #000000; --grad-end: #000000;">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="Icon" aria-hidden="true">
                    <defs>
                      <mask id="tidal_T_Diamond_Shape-<%= index %>">
                        <circle fill="#FFFFFF" cx="256" cy="256" r="256" />
                        <g fill="#000000">
                          <polygon points="126.86,131.14 196.86,201.14 126.86,271.14 56.86,201.14" />
                          <polygon points="256,131.14 326,201.14 256,271.14 186,201.14" />
                          <polygon points="385.14,131.14 455.14,201.14 385.14,271.14 315.14,201.14" />
                          <polygon points="256,260.28 326,330.28 256,400.28 186,330.28" />
                        </g>
                      </mask>
                    </defs>
                    <circle fill="#FFFFFF" mask="url(#tidal_T_Diamond_Shape-<%= index %>)" cx="256" cy="256" r="256" />
                  </svg>
                </div>
              <% } %>
            </div>
            <button type="button" class="copy-track-btn" data-slug="<%= track.slug %>" onclick="copyTrackUrl(this)" title="Copy Link" aria-label="Copy Link">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </button>
          </li>
        <% }); %>

        <li class="TrackRow TotalRow">
          <span class="TrackTitle TotalLabel">Total Duration</span>
          <span class="TrackTime">
            <time datetime="<%= release.duration || 'N/A' %>"><%= release.release_duration || 'N/A' %></time>
          </span>
        </li>
      </ul>
    </div>
  </div>
</div>